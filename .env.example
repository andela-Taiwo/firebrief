# Copy to .env for local development. Every variable the app reads belongs here.
# No real secrets in this file, ever.

FIREBRIEF_ENV=development

# Postgres. Two roles: firebrief owns and migrates; firebrief_app is the runtime
# role and is NOT a superuser and NOT BYPASSRLS, so RLS applies to it.
FIREBRIEF_DATABASE_URL=postgresql+asyncpg://firebrief:firebrief_dev@127.0.0.1:55433/firebrief_dev
FIREBRIEF_TEST_DATABASE_URL=postgresql+asyncpg://firebrief:firebrief_dev@127.0.0.1:55433/firebrief_test
FIREBRIEF_APP_DATABASE_URL=postgresql+asyncpg://firebrief_app:firebrief_app_dev@127.0.0.1:55433/firebrief_test

# Redis is a fast path only; it is never the source of truth for spend
FIREBRIEF_REDIS_URL=redis://127.0.0.1:56380/0

# Model providers. The app must refuse to boot in production without these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Prices for the budget service
FIREBRIEF_PRICING_FILE=config/pricing.toml

# Observability
FIREBRIEF_LOG_LEVEL=INFO

# Local development server (`make api`).
# It connects as the runtime role; the API refuses to start as the owner, because a
# superuser can drop the row-level-security policies.
FIREBRIEF_DATABASE_URL=postgresql+asyncpg://firebrief_app:firebrief_app_dev@127.0.0.1:55433/firebrief_test

# Seeding creates a tenant, which is a privileged onboarding action, so it uses the owner.
FIREBRIEF_OWNER_DATABASE_URL=postgresql+asyncpg://firebrief:firebrief_dev@127.0.0.1:55433/firebrief_test

# extractive (no key, quotes the top source) | anthropic | openai
FIREBRIEF_PROVIDER=extractive

# Where the sign-in link printed by the console sender points.
FIREBRIEF_WEB_URL=http://127.0.0.1:5173
